{
  "name": "whatsapp-bot-workspace",
  "version": "1.0.0",
  "description": "iTechnic Mobiles WhatsApp Business API & CRM Dashboard",
  "scripts": {
    "start": "node backend/index.js",
    "build": "node -e \"console.log('Render Build Succeeded')\"",
    "build:frontend": "npm --prefix frontend run build",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "postinstall": "cd backend && npm install"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^9.6.2",
    "node-cron": "^4.2.1"
  }
}

